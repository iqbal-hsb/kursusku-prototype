:root {
    --primary-color: #0066cc;
    --primary-dark: #004499;
    --secondary-color: #eaf4ff;
    --bg-color: #f8f9fa;
    --text-color: #333333;
    --text-light: #718096;
    --card-bg: #ffffff;
    --border-color: #e2e8f0;
    --success-bg: #e8f7ef;
    --success-color: #176b3a;
}

/* =========================
   RESET
   ========================= */

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
    line-height: 1.6;
    color: var(--text-color);
    background-color: var(--bg-color);
    margin: 0;
    padding: 0;
}

/* =========================
   HEADER & NAVIGASI
   ========================= */

header {
    background-color: #ffffff;
    border-bottom: 1px solid var(--border-color);
    padding: 1rem 2rem;
    position: sticky;
    top: 0;
    z-index: 1000;
}

nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    max-width: 1000px;
    margin: 0 auto;
    flex-wrap: wrap;
}

nav a {
    text-decoration: none;
    color: #4a5568;
    font-weight: 500;
    transition: 0.2s;
}

nav a:hover {
    color: var(--primary-color);
}

/* =========================
   MAIN
   ========================= */

main {
    max-width: 1000px;
    margin: 2rem auto;
    padding: 0 1.5rem;
}

section {
    background: var(--card-bg);
    border-radius: 12px;
    padding: 2rem;
    margin-bottom: 2rem;
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.06);
}

section h2 {
    margin-top: 0;
    color: #1f2937;
}

/* =========================
   HERO
   ========================= */

#hero {
    background: linear-gradient(
        135deg,
        var(--primary-color),
        var(--primary-dark)
    );
    color: white;
    text-align: center;
    padding: 3.5rem 2rem;
}

#hero h1 {
    margin-top: 0;
    font-size: 2.2rem;
}

#hero p {
    max-width: 700px;
    margin: 0 auto;
}

#hero a {
    display: inline-block;
    background-color: #ffffff;
    color: var(--primary-color);
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    text-decoration: none;
    font-weight: bold;
    margin-top: 1.2rem;
    transition: 0.2s;
}

#hero a:hover {
    background-color: #eaf4ff;
    transform: translateY(-2px);
}

/* =========================
   ARTICLE / CARD
   ========================= */

article {
    background: #f1f5f9;
    border-left: 4px solid var(--primary-color);
    padding: 1.2rem;
    margin-bottom: 1rem;
    border-radius: 0 8px 8px 0;
}

article h3 {
    margin-top: 0;
    color: #1f2937;
}

article a {
    color: var(--primary-color);
    font-weight: bold;
    text-decoration: none;
}

article a:hover {
    text-decoration: underline;
}

/* =========================
   KALKULATOR PERTEMUAN 3
   ========================= */

.calculator-card {
    background: #ffffff;
    border-radius: 14px;
    padding: 2rem;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.07);
}

.calculator-card h2 {
    color: var(--primary-color);
    margin-top: 0;
}

.course-info {
    background: var(--secondary-color);
    border-left: 4px solid var(--primary-color);
    padding: 1rem;
    border-radius: 8px;
    margin-bottom: 1.5rem;
}

/* Tabel biaya */

.cost-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 1rem;
    background: #ffffff;
}

.cost-table th {
    background: var(--primary-color);
    color: #ffffff;
    padding: 14px;
    text-align: left;
}

.cost-table td {
    padding: 14px;
    border-bottom: 1px solid var(--border-color);
}

.cost-table tr:nth-child(even) {
    background-color: #f8fafc;
}

.cost-table tr:hover {
    background-color: #eef6ff;
}

/* Total akhir */

.cost-table .total {
    background-color: var(--success-bg);
    color: var(--success-color);
    font-weight: bold;
    font-size: 1.1rem;
}

/* Tombol kalkulator */

.btn-calculator {
    display: inline-block;
    background-color: var(--primary-color);
    color: #ffffff;
    padding: 0.75rem 1.3rem;
    border-radius: 8px;
    text-decoration: none;
    font-weight: bold;
    margin-top: 1rem;
    transition: 0.2s;
}

.btn-calculator:hover {
    background-color: var(--primary-dark);
    transform: translateY(-2px);
}

/* Tombol kembali */

.btn-back {
    display: inline-block;
    margin-top: 1.5rem;
    color: var(--primary-color);
    text-decoration: none;
    font-weight: bold;
}

.btn-back:hover {
    text-decoration: underline;
}

/* =========================
   MEDIA
   ========================= */

img,
video {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
}

video {
    display: block;
    margin-top: 1rem;
}

/* =========================
   FOOTER
   ========================= */

footer {
    text-align: center;
    padding: 1.5rem;
    color: var(--text-light);
    font-size: 0.9rem;
}

/* =========================
   RESPONSIVE / HP
   ========================= */

@media (max-width: 700px) {

    header {
        padding: 1rem;
    }

    nav {
        gap: 0.8rem;
    }

    nav a {
        font-size: 14px;
    }

    main {
        margin: 1rem auto;
        padding: 0 1rem;
    }

    section {
        padding: 1.3rem;
    }

    #hero {
        padding: 2.5rem 1.2rem;
    }

    #hero h1 {
        font-size: 1.7rem;
    }

    .cost-table th,
    .cost-table td {
        padding: 10px;
        font-size: 14px;
    }
}