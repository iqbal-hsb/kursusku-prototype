/* =========================
   VARIABLES & THEME
   ========================= */
:root {
    /* Brand & Primary Colors */
    --primary-color: #0f766e;
    --primary-dark: #0b5f55;
    --secondary-color: #eef8f5;
    
    /* Layout & Surface Colors */
    --bg-color: #f6f9f8;
    --card-bg: #ffffff;
    --text-color: #14231f;
    --text-light: #60756e;
    --border-color: #d9e6e2;
    --input-border: #b8ccc6;
    --muted: #e2e8f0;
    --line: #d9e6e2;
    
    /* Status Colors */
    --success-bg: #eaf8f1;
    --success-color: #17824f;
    --badge-full-bg: #fee2e2;
    --badge-full-color: #dc2626;
    --badge-avail-bg: #d1fae5;
    --badge-avail-color: #059669;
}

/* =========================
   RESET & BASE STYLES
   ========================= */
* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: "Segoe UI", Arial, Helvetica, sans-serif;
    line-height: 1.6;
    color: var(--text-color);
    background-color: var(--bg-color);
    margin: 0;
    padding: 0;
}

.container {
    width: min(1080px, 92%);
    margin-inline: auto;
}

a {
    color: var(--primary-dark);
}

/* =========================
   HEADER & NAVIGASI
   ========================= */
header,
.site-header {
    background-color: var(--card-bg);
    border-bottom: 1px solid var(--border-color);
    padding: 1rem 2rem;
    position: sticky;
    top: 0;
    z-index: 1000;
}

.nav-wrap {
    min-height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
}

nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    max-width: 1000px;
    margin: 0 auto;
    flex-wrap: wrap;
}

nav a {
    text-decoration: none;
    color: #4a5568;
    font-weight: 500;
    transition: 0.2s;
}

nav a:hover {
    color: var(--primary-color);
}

.brand {
    font-weight: 800;
    text-decoration: none;
    color: var(--primary-dark);
}

/* =========================
   MAIN & SECTIONS
   ========================= */
main {
    max-width: 1000px;
    margin: 2rem auto;
    padding: 0 1.5rem;
}

section {
    background: var(--card-bg);
    border-radius: 12px;
    padding: 2rem;
    margin-bottom: 2rem;
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.06);
}

section h2 {
    margin-top: 0;
    color: #1f2937;
}

.page-intro {
    max-width: 720px;
    margin: 2.5rem auto 1.25rem;
}

.eyebrow {
    color: var(--primary-color);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .05em;
}

/* =========================
   HERO SECTION
   ========================= */
#hero {
    background: linear-gradient(
        135deg,
        var(--primary-color),
        var(--primary-dark)
    );
    color: #ffffff;
    text-align: center;
    padding: 3.5rem 2rem;
    border-radius: 12px;
}

#hero h1 {
    margin-top: 0.5rem;
    font-size: 2.2rem;
}

#hero p {
    max-width: 700px;
    margin: 0 auto;
}

#hero .eyebrow {
    color: #a7f3d0;
}

/* =========================
   ARTICLE / CARD & SUMMARY
   ========================= */
article {
    background: #f1f5f9;
    border-left: 4px solid var(--primary-color);
    padding: 1.2rem;
    margin-bottom: 1rem;
    border-radius: 0 8px 8px 0;
}

article h3 {
    margin-top: 0;
    color: #1f2937;
}

article a {
    color: var(--primary-color);
    font-weight: bold;
    text-decoration: none;
}

article a:hover {
    text-decoration: underline;
}

.summary-card,
.form-card {
    max-width: 760px;
    margin: 0 auto 2rem;
    padding: 1.5rem;
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 1rem;
}

/* =========================
   TABEL BIAYA & STATUS
   ========================= */
.table-container {
    background-color: var(--card-bg);
    border-radius: 12px;
    padding: 20px;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    margin-top: 20px;
    overflow-x: auto;
}

table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 1rem;
    background: #ffffff;
    font-size: 14px;
    text-align: left;
}

th {
    background: var(--primary-color);
    color: #ffffff;
    padding: 14px;
    font-weight: 600;
    border-bottom: 2px solid var(--border-color);
}

td {
    padding: 14px;
    border-bottom: 1px solid var(--border-color);
    color: #4b5563;
}

tr:nth-child(even) {
    background-color: #f8fafc;
}

tr:hover {
    background-color: var(--secondary-color);
}

.badge-full {
    color: var(--badge-full-color);
    font-weight: 600;
    background-color: var(--badge-full-bg);
    padding: 4px 8px;
    border-radius: 4px;
}

.badge-available {
    color: var(--badge-avail-color);
    font-weight: 600;
    background-color: var(--badge-avail-bg);
    padding: 4px 8px;
    border-radius: 4px;
}

/* =========================
   BUTTONS & ALERTS
   ========================= */
.btn-primary {
    display: inline-block;
    background-color: var(--primary-color);
    color: #ffffff !important;
    padding: 0.75rem 1.3rem;
    border: 0;
    border-radius: .7rem;
    text-decoration: none;
    font-weight: bold;
    cursor: pointer;
    transition: 0.2s;
}

.btn-primary:hover {
    background-color: var(--primary-dark);
    transform: translateY(-2px);
}

.btn-link {
    display: inline-block;
    padding: 0.75rem 1.3rem;
    color: var(--text-color);
    border-radius: .7rem;
    text-decoration: none;
    font-weight: bold;
    transition: 0.2s;
}

.btn-link:hover {
    background-color: #cbd5e1 !important;
}

/* =========================
   FOOTER & MEDIA
   ========================= */
img, video {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
}

footer {
    text-align: center;
    padding: 2rem 0;
    border-top: 1px solid var(--line);
    margin-top: 2rem;
    color: var(--text-light);
    font-size: 0.9rem;
}

@media (max-width: 700px) {
    header { padding: 1rem; }
    main { margin: 1rem auto; padding: 0 1rem; }
    #hero { padding: 2.5rem 1.2rem; }
    #hero h1 { font-size: 1.7rem; }
}