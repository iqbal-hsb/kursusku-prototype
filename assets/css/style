/* =========================
   VARIABLES & THEME
   ========================= */
:root {
    /* Brand & Primary Colors */
    --primary-color: #0f766e;
    --primary-dark: #0b5f55;
    --secondary-color: #eef8f5;
    
    /* Layout & Surface Colors */
    --bg-color: #f6f9f8;
    --card-bg: #ffffff;
    --text-color: #14231f;
    --text-light: #60756e;
    --border-color: #d9e6e2;
    --input-border: #b8ccc6;
    
    /* Status Colors */
    --success-bg: #eaf8f1;
    --success-color: #17824f;
    --badge-full-bg: #fee2e2;
    --badge-full-color: #dc2626;
    --badge-avail-bg: #d1fae5;
    --badge-avail-color: #059669;
}

/* =========================
   RESET & BASE STYLES
   ========================= */
* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: "Segoe UI", Arial, Helvetica, sans-serif;
    line-height: 1.6;
    color: var(--text-color);
    background-color: var(--bg-color);
    margin: 0;
    padding: 0;
}

.container {
    width: min(1080px, 92%);
    margin-inline: auto;
}

a {
    color: var(--primary-dark);
}

/* =========================
   HEADER & NAVIGASI
   ========================= */
header,
.site-header {
    background-color: var(--card-bg);
    border-bottom: 1px solid var(--border-color);
    padding: 1rem 2rem;
    position: sticky;
    top: 0;
    z-index: 1000;
}

.nav-wrap {
    min-height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
}

nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    max-width: 1000px;
    margin: 0 auto;
    flex-wrap: wrap;
}

nav a {
    text-decoration: none;
    color: #4a5568;
    font-weight: 500;
    transition: 0.2s;
}

nav a:hover {
    color: var(--primary-color);
}

.brand {
    font-weight: 800;
    text-decoration: none;
    color: var(--primary-dark);
}

/* =========================
   MAIN & SECTIONS
   ========================= */
main {
    max-width: 1000px;
    margin: 2rem auto;
    padding: 0 1.5rem;
}

section {
    background: var(--card-bg);
    border-radius: 12px;
    padding: 2rem;
    margin-bottom: 2rem;
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.06);
}

section h2 {
    margin-top: 0;
    color: #1f2937;
}

.page-intro {
    max-width: 720px;
    margin: 2.5rem auto 1.25rem;
}

.eyebrow {
    color: var(--primary-color);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .05em;
}

/* =========================
   HERO SECTION
   ========================= */
#hero {
    background: linear-gradient(
        135deg,
        var(--primary-color),
        var(--primary-dark)
    );
    color: #ffffff;
    text-align: center;
    padding: 3.5rem 2rem;
}

#hero h1 {
    margin-top: 0;
    font-size: 2.2rem;
}

#hero p {
    max-width: 700px;
    margin: 0 auto;
}

#hero a {
    display: inline-block;
    background-color: #ffffff;
    color: var(--primary-color);
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    text-decoration: none;
    font-weight: bold;
    margin-top: 1.2rem;
    transition: 0.2s;
}

#hero a:hover {
    background-color: var(--secondary-color);
    transform: translateY(-2px);
}

/* =========================
   ARTICLE / CARD & SUMMARY
   ========================= */
article {
    background: #f1f5f9;
    border-left: 4px solid var(--primary-color);
    padding: 1.2rem;
    margin-bottom: 1rem;
    border-radius: 0 8px 8px 0;
}

article h3 {
    margin-top: 0;
    color: #1f2937;
}

article a {
    color: var(--primary-color);
    font-weight: bold;
    text-decoration: none;
}

article a:hover {
    text-decoration: underline;
}

.summary-card {
    max-width: 760px;
    margin: 0 auto 2rem;
    padding: 1.5rem;
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 1rem;
}

.summary-list {
    display: grid;
    grid-template-columns: 150px 1fr;
    gap: 0.65rem 1rem;
}

.summary-list dt { 
    font-weight: 700; 
}

.summary-list dd { 
    margin: 0; 
}

/* =========================
   FORM & INPUTS
   ========================= */
.form-card {
    max-width: 760px;
    margin: 0 auto 2rem;
    padding: 1.5rem;
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 1rem;
}

.form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
}

.form-group { 
    margin-bottom: 1rem; 
}

label,
legend {
    display: block;
    font-weight: 700;
    margin-bottom: .35rem;
}

input,
select,
textarea,
button {
    font: inherit;
}

input[type="text"],
input[type="email"],
input[type="tel"],
select,
textarea {
    width: 100%;
    padding: 0.8rem 0.9rem;
    border: 1px solid var(--input-border);
    border-radius: .65rem;
    background: #ffffff;
}

input:focus,
select:focus,
textarea:focus {
    outline: 3px solid rgba(15, 118, 110, 0.18);
    border-color: var(--primary-color);
}

.choice {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    margin-right: 1rem;
    font-weight: 400;
}

.help { 
    color: var(--text-light); 
}

/* =========================
   TABEL BIAYA & STATUS
   ========================= */
.calculator-card {
    background: var(--card-bg);
    border-radius: 14px;
    padding: 2rem;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.07);
}

.calculator-card h2 {
    color: var(--primary-color);
    margin-top: 0;
}

.course-info {
    background: var(--secondary-color);
    border-left: 4px solid var(--primary-color);
    padding: 1rem;
    border-radius: 8px;
    margin-bottom: 1.5rem;
}

.table-container {
    background-color: var(--card-bg);
    border-radius: 12px;
    padding: 20px;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    margin-top: 20px;
    overflow-x: auto;
}

table,
.cost-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 1rem;
    background: #ffffff;
    font-size: 14px;
    text-align: left;
}

th,
.cost-table th {
    background: var(--primary-color);
    color: #ffffff;
    padding: 14px;
    font-weight: 600;
    border-bottom: 2px solid var(--border-color);
}

td,
.cost-table td {
    padding: 14px;
    border-bottom: 1px solid var(--border-color);
    color: #4b5563;
}

.cost-table tr:nth-child(even) {
    background-color: #f8fafc;
}

.cost-table tr:hover {
    background-color: var(--secondary-color);
}

.cost-table .total {
    background-color: var(--success-bg);
    color: var(--success-color);
    font-weight: bold;
    font-size: 1.1rem;
}

/* Badge Status Kuota */
.badge-full {
    color: var(--badge-full-color);
    font-weight: 600;
    background-color: var(--badge-full-bg);
    padding: 4px 8px;
    border-radius: 4px;
}

.badge-available {
    color: var(--badge-avail-color);
    font-weight: 600;
    background-color: var(--badge-avail-bg);
    padding: 4px 8px;
    border-radius: 4px;
}

/* =========================
   BUTTONS & ALERTS
   ========================= */
.btn-primary,
.btn-calculator {
    display: inline-block;
    background-color: var(--primary-color);
    color: #ffffff;
    padding: 0.75rem 1.3rem;
    border: 0;
    border-radius: .7rem;
    text-decoration: none;
    font-weight: bold;
    cursor: pointer;
    transition: 0.2s;
}

.btn-primary:hover,
.btn-calculator:hover {
    background-color: var(--primary-dark);
    transform: translateY(-2px);
}

.btn-link,
.btn-back {
    display: inline-block;
    margin-top: 1.5rem;
    color: var(--primary-color);
    text-decoration: none;
    font-weight: bold;
}

.btn-link:hover,
.btn-back:hover {
    text-decoration: underline;
}

.alert-success {
    max-width: 760px;
    margin: 2rem auto 1rem;
    padding: 1.2rem;
    background: var(--success-bg);
    border-left: 4px solid var(--success-color);
}

/* =========================
   MEDIA ELEMENTS
   ========================= */
img,
video {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
}

video {
    display: block;
    margin-top: 1rem;
}

/* =========================
   FOOTER
   ========================= */
footer {
    text-align: center;
    padding: 1.5rem;
    color: var(--text-light);
    font-size: 0.9rem;
}

/* =========================
   RESPONSIVE / MOBILE
   ========================= */
@media (max-width: 700px) {
    header {
        padding: 1rem;
    }

    .nav-wrap { 
        align-items: flex-start; 
        padding-block: .8rem; 
    }

    nav {
        gap: 0.8rem;
    }

    nav a {
        font-size: 14px;
    }

    main {
        margin: 1rem auto;
        padding: 0 1rem;
    }

    section {
        padding: 1.3rem;
    }

    #hero {
        padding: 2.5rem 1.2rem;
    }

    #hero h1 {
        font-size: 1.7rem;
    }

    .form-grid { 
        grid-template-columns: 1fr; 
    }

    .form-card,
    .summary-card { 
        padding: 1rem; 
    }

    .summary-list { 
        grid-template-columns: 1fr; 
    }

    th, td,
    .cost-table th,
    .cost-table td {
        padding: 10px;
        font-size: 14px;
    }
}